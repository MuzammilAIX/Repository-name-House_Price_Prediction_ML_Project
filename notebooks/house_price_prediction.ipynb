# %% [markdown]
# # House Price prediction

# %% [markdown]
# ### 1. Problem Statement

# %% [markdown]
# - House prices in Bengaluru vary widely with location, area, and size, making it hard to judge if a - property is fairly priced.
# - Buyers and sellers need a reliable, data-driven way to estimate prices instead of relying on guesswork.
# - Goal: Build a machine learning regression model to predict house price (in lakhs) from location, total sqft, BHK, and number of bathrooms.

# %% [markdown]
# ### 2. Load Dataset and import required packages

# %%
import numpy as np
import pandas as pd 
import seaborn as sns 
import matplotlib.pyplot as plt 
%matplotlib inline 
import warnings 
warnings.filterwarnings("ignore") 

df = pd.read_csv('../data/src/housing.csv')
df.head()

# %% [markdown]
# #### Shape of Dataset

# %%
print(f"Rows of Dataset are {df.shape[0]} and Columns of Datasset are {df.shape[1]}.")

# %% [markdown]
# #### Dataset information

# %% [markdown]
# - 13,320 rows and 9 columns
# - Features: area_type, availability, location, size, society, total_sqft, bath, balcony
# - Target: price (in lakhs)
# - Missing values in society, balcony, bath, size, and location
# 529 duplicate rows

# %% [markdown]
# #### Data Checks to Perform

# %% [markdown]
# - Check Missing values
# - Check Duplicates
# - check Data Type
# - no. of unique values of each columns
# - Check statistics of Dataset
# - Check various categories present in different categories columns

# %% [markdown]
# ##### Check Missing values

# %%
df.isnull().sum()

# %%
df['location'] = df['location'].fillna(df['location'].mode()[0], inplace=True)
df['size'] = df['size'].fillna(df['size'].mode()[0], inplace=True)
df['bath'] = df['bath'].fillna(df['bath'].mean(), inplace=True)
df['balcony'] = df['balcony'].fillna(df['balcony'].median(), inplace=True)


# %%
df.drop(columns=['area_type','availability','society'], inplace=True)

# %%
df.isnull().sum()

# %% [markdown]
# #### Check Duplicates

# %%
df.duplicated().sum()

# %%
df.drop_duplicates(inplace=True)

# %%
df.duplicated().sum()

# %% [markdown]
# #### Check Data Type

# %%
df.info()

# %% [markdown]
# #### Check the number of unique values of each columns

# %%
df.nunique()

# %% [markdown]
# ##### Check the Statistics of Dataset

# %%
df.describe()

# %%
df.location.value_counts()


# %%
df['location'] = df['location'].apply(lambda x:x.strip())
df['location']

# %%
location_stats = df.groupby('location')['location'].agg('count').sort_values(ascending=True)
location_stats

# %%
location_less_than_ten_entries = location_stats[location_stats <= 10]
location_less_than_ten_entries

# %%
df['location'] = df['location'].apply(lambda x: 'other' if x in location_less_than_ten_entries else x)

# %%
df['location'].value_counts()

# %%
df['size'].unique()

# %%
df['bedrooms'] = df['size'].apply(lambda x:int(x.split(' ')[0]))

# %%
df

# %%
df.total_sqft.unique()

# %%
def clean(sqft):
    tokens = sqft.split('-')
    if tokens == 2:
        return (float(tokens[0]) + float(tokens[1]))/2
    else:
        try:
            return float(sqft) 
        except:
            return None       

# %%
print(clean('300-50'))


# %%
df['total_sqft'] = df['total_sqft'].apply(clean)

# %%
df['total_sqft'].unique()

# %%
df

# %%
df.describe()

# %%
df['sqft_per_bed'] = df['total_sqft']/df['bedrooms']

# %%
df

# %%
df.sqft_per_bed.describe()

# %%
df2 = df[df['sqft_per_bed'] >= 300]

# %%
df2

# %%
df2['price_per_sqft'] = round(df2['price']* 100000/df2['total_sqft'],2)




# %%
df


# %%
df2.price_per_sqft.describe()

# %%
df3 = df2[df2['price_per_sqft'] >= 2000]

# %%
df3

# %%
df3.drop(columns=['size', 'sqft_per_bed', 'price_per_sqft'], inplace=True)

# %%
df3

# %%
from sklearn.preprocessing import OneHotEncoder, StandardScaler
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.pipeline import make_pipeline
from sklearn.compose import make_column_transformer


# %%
col_trans = make_column_transformer((OneHotEncoder(sparse_output=False), ['location']), remainder='passthrough')

# %%
lr = LinearRegression()


# %%
scaler = StandardScaler()

# %%
model = make_pipeline(col_trans,scaler,lr)

# %%
X = df3.drop(columns = ['price'])
y= df3['price']

# %%
X_train,X_test,y_train,y_test = train_test_split(X,y,test_size=0.2)

# %%
model.fit(X_train,y_train)


# %%
model.score(X_test,y_test)

# %%
input = pd.DataFrame([['Electronic City Phase II',2000.0,3.0,2.0,3]], columns=['location','total_sqft','bath','balcony','bedrooms'])

# %%
model.predict(input)

# %%
import pickle as pk


# %%
pk.dump(model, open('House_prediction_model.pkl', 'wb'))



# %%
df3.to_csv("Cleaned_data.csv")

